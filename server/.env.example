# Copy to .env and fill in.

# --- Server ---------------------------------------------------------------
PORT=4000
# 0.0.0.0 makes the API reachable from phones on the same network.
HOST=0.0.0.0
NODE_ENV=production

# --- Database -------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=smallville_engineering
PGUSER=postgres
PGPASSWORD=change-me

# --- Auth -----------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# --- Logs -----------------------------------------------------------------
# access-*.log (every request), app-*.log (startup/warnings/errors),
# error-*.log (errors + stack traces). Rotated daily and gzipped; anything
# older than LOG_KEEP_DAYS is deleted so the disk can't fill.
LOG_DIR=./logs
LOG_KEEP_DAYS=30

# --- CORS -----------------------------------------------------------------
# Comma-separated list of the two front-end origins.
# Use the server's LAN IP so phones can reach it, e.g. http://192.168.1.50:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Locale ---------------------------------------------------------------
APP_TIMEZONE=Asia/Beirut
